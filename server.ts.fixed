// Ruta para ver las reseñas de un banco específico
router.get("/reseñas/:banco", async (ctx) => {
    const { banco } = ctx.params;
    
    // Filtrar reseñas específicas del banco
    const reseñasBanco = reseñas.filter(reseña => reseña.banco === banco);
    
    // Calcular promedio de calificaciones para este banco
    let totalCalificaciones = 0;
    reseñasBanco.forEach(reseña => {
        totalCalificaciones += parseInt(reseña.calificación);
    });
    const promedio = reseñasBanco.length > 0 
        ? (totalCalificaciones / reseñasBanco.length).toFixed(1) 
        : "0.0";
    
    // Obtener la imagen del banco
    const imagenBanco = obtenerImagenBanco(banco);
    
    let htmlContent = `
