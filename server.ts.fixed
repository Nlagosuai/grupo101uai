                    padding: 1rem 2rem;
                }

                .navbar-content {
                    max-width: 1200px;
                    margin: 0 auto;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                }

                .logo {
                    font-size: 1.5rem;
                    font-weight: 600;
                    color: var(--color-primary);
                    text-decoration: none;
                }

