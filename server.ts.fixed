// Utilidad para guardar y cargar reseñas desde un archivo
const DB_FILE = "./reviews.json";

/**
 * Esta función analiza los comentarios de reseñas que no tienen categorías asignadas
 * y les asigna categorías automáticamente basándose en palabras clave.
 * Por ejemplo, si un comentario menciona "lento", le asigna la categoría "lentitud".
 * Si no encuentra ninguna palabra clave, asigna la categoría "otro".
 * Es como un detector automático de problemas en los comentarios de los usuarios.
 */
function asignarCategoriasAResenas(reseñas) {
    return reseñas.map(reseña => {
        // Si ya tiene categorías, no hacer nada
        if (reseña.categorías && reseña.categorías.length > 0) {
            return reseña;
        }
        
        const comentario = reseña.comentario.toLowerCase();
        const categorías: string[] = [];
        
        // Analizar el comentario para asignar categorías
        if (comentario.includes('lent') || comentario.includes('demor') || comentario.includes('tard')) {
            categorías.push('lentitud');
        }
        if (comentario.includes('acces') || comentario.includes('ingres') || comentario.includes('entr') || comentario.includes('login')) {
            categorías.push('acceso');
        }
        if (comentario.includes('error') || comentario.includes('fall') || comentario.includes('problem')) {
            categorías.push('error');
        }
        if (comentario.includes('segur') || comentario.includes('contrase') || comentario.includes('robo')) {
            categorías.push('seguridad');
        }
        
        // Si no se identificó ninguna categoría, asignar "otro"
        if (categorías.length === 0) {
            categorías.push('otro');
        }
        
        // Retornar la reseña con categorías asignadas
        return {
            ...reseña,
            categorías
        };
    });
}

/**
 * Esta función guarda las reseñas de los usuarios en un archivo JSON.
 * Es como un bibliotecario que archiva todas las opiniones de los clientes
 * para que no se pierdan y podamos consultarlas después.
 */
async function guardarReseñas(reseñas: Reseña[]) {
    try {
        await Deno.writeTextFile(DB_FILE, JSON.stringify(reseñas, null, 2));
    } catch (error) {
        console.error("Error al guardar reseñas:", error);
    }
}

/**
 * Esta función lee todas las reseñas guardadas en el archivo JSON.
 * Además, si encuentra reseñas sin categorías, les asigna categorías automáticamente.
 * Es como un bibliotecario que no solo te entrega los libros, sino que también
 * los organiza por temas si no estaban clasificados.
 */
async function cargarReseñas(): Promise<Reseña[]> {
    try {
        const contenido = await Deno.readTextFile(DB_FILE);
        const reseñasCargadas = JSON.parse(contenido);
        
        // Asignar categorías a reseñas sin categorías
        const reseñasActualizadas = asignarCategoriasAResenas(reseñasCargadas);
        
        // Si hubo cambios, guardar las reseñas actualizadas
        if (JSON.stringify(reseñasCargadas) !== JSON.stringify(reseñasActualizadas)) {
            await guardarReseñas(reseñasActualizadas);
            console.log("Reseñas actualizadas con categorías asignadas automáticamente");
        }
        
        return reseñasActualizadas;
    } catch (error) {
        // Si el archivo no existe o hay error, devolver array vacío
        console.error("Error al cargar reseñas:", error);
        return [];
    }
}

/**
 * Esta función verifica si un banco está en línea o no.
 * Es como un vigilante que revisa constantemente si la página web de cada banco funciona.
 * Si el banco responde, se marca como "activo", y si no responde, se marca como "inactivo".
 * También captura información como el estado HTTP y el tiempo de respuesta.
 */
async function verificarBanco(nombre, url) {
    try {
        // Intentar obtener respuesta del banco con un tiempo límite
        const inicioTiempo = Date.now();
        const bancoInfo = bancos.find(b => b.nombre === nombre);
        
        const respuesta = await fetch(url, { 
            method: 'HEAD',
            signal: AbortSignal.timeout(5000) // Timeout de 5 segundos
        });
        
        const tiempoRespuesta = Date.now() - inicioTiempo;
        
        // Retornar información sobre el estado
        return {
            nombre: nombre,
            url: url,
            tiempoRespuesta: `${tiempoRespuesta}ms`,
            codigoEstado: respuesta.status,
            status: respuesta.ok ? "ACTIVO" : `INACTIVO (Código: ${respuesta.status})`,
            estado: respuesta.ok ? "activo" : "inactivo",
            icono: bancoInfo?.icono || "https://via.placeholder.com/100x50?text=Banco"
        };
    } catch (error) {
        console.log(`Error al verificar ${nombre}: ${error.message}`);
        // En caso de error, retornar información de banco inactivo
        const bancoInfo = bancos.find(b => b.nombre === nombre);
        return {
            nombre: nombre,
            url: url,
            tiempoRespuesta: "N/A",
            codigoEstado: 0,
            status: `INACTIVO (Error: ${error.message})`,
            estado: "inactivo",
            icono: bancoInfo?.icono || "https://via.placeholder.com/100x50?text=Banco"
        };
    }
}

/**
 * Esta función obtiene el estado de todos los bancos en la lista.
 * Es como un supervisor que le pide a cada vigilante (verificarBanco)
 * que revise su banco asignado y luego recopila todos los informes.
 */
async function obtenerEstados() {
    return await Promise.all(bancos.map(banco => verificarBanco(banco.nombre, banco.url)));
}

