/**
 * Esta función convierte una calificación numérica en estrellas visuales.
 * Es como un traductor que convierte números (1-5) en símbolos de estrellas
 * para que sea más fácil y visual entender la calificación.
 */
function renderStars(rating) {
    let stars = '';
    const ratingNum = parseInt(rating);
    
    for (let i = 1; i <= 5; i++) {
        if (i <= ratingNum) {
            stars += '★'; // Estrella llena
        } else {
            stars += '☆'; // Estrella vacía
        }
    }
    return stars;
}

/**
 * Esta función obtiene la imagen (logo) de un banco por su nombre.
 * Es como un buscador de imágenes que encuentra el logo oficial
 * del banco que le indiques, o devuelve una imagen genérica si no lo encuentra.
 */
function obtenerImagenBanco(nombreBanco) {
    const banco = bancos.find(b => b.nombre === nombreBanco);
    return banco ? banco.icono : 'https://via.placeholder.com/64?text=Banco';
}

