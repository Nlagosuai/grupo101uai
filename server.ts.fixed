// Ruta para la API de login
router.post("/api/login", async (ctx) => {
    const body = await ctx.request.body();
    let formData;
    
    if (body.type === "form") {
        formData = await body.value;
    } else {
        ctx.response.status = 400;
        ctx.response.body = "Formato de solicitud no válido";
        return;
    }
    
    const username = formData.get("username");
    const password = formData.get("password");
    
    // Para simplificar, usamos credenciales hardcodeadas
    // En un entorno real, verificaríamos contra una base de datos
    if (username === "admin" && password === "password") {
        // Establecer cookie de autenticación
        ctx.cookies.set("authenticated", "true", {
            httpOnly: true,
            sameSite: "lax",
            maxAge: 24 * 60 * 60 * 1000, // 1 día
        });
        
        // Redirigir al inicio
        ctx.response.redirect("/");
    } else {
        // Redirigir a login con error
        ctx.response.redirect("/login?error=invalid");
    }
});

// Ruta para cerrar sesión
router.get("/logout", async (ctx) => {
    // Eliminar cookie de autenticación
    ctx.cookies.delete("authenticated");
    
    // Redirigir a login
    ctx.response.redirect("/login");
});

// Ruta para la página de estadísticas
router.get("/estadisticas", async (ctx) => {
    const estados = await obtenerEstados();
    
    // Objeto para almacenar la información de reportes por banco
    const reportesPorBanco = {};
    
    // Para cada banco, encontrar el reporte más común
    bancos.forEach(banco => {
        const reseñasBanco = reseñas.filter(r => r.banco === banco.nombre);
        
        if (reseñasBanco.length > 0) {
            // Contamos las categorías más comunes
            const conteoCategorias = {};
            
            // Iterar por cada reseña y sus categorías
            reseñasBanco.forEach(reseña => {
                if (reseña.categorías && reseña.categorías.length > 0) {
                    reseña.categorías.forEach(categoria => {
                        conteoCategorias[categoria] = (conteoCategorias[categoria] || 0) + 1;
                    });
                }
            });
            
            // Encontrar la categoría más común
            let categoriaComun = "";
            let maxConteo = 0;
            
            for (const [categoria, conteo] of Object.entries(conteoCategorias)) {
                if ((conteo as number) > maxConteo) {
                    maxConteo = conteo as number;
                    categoriaComun = categoria;
                }
            }
            
            // Si no hay categorías, usar "Sin categoría específica"
            reportesPorBanco[banco.nombre] = {
                reporteComun: categoriaComun || "Sin categoría específica",
                conteo: maxConteo || 0,
                totalReseñas: reseñasBanco.length
            };
        } else {
            // Si no hay reseñas para este banco
            reportesPorBanco[banco.nombre] = {
                reporteComun: "Sin reportes",
                conteo: 0,
                totalReseñas: 0
            };
        }
    });

    let htmlContent = `
