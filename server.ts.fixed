                        --color-primary: #8B7355;
                        --color-secondary: #D2B48C;
                        --color-accent: #DEB887;
                        --color-background: #FAF0E6;
                        --color-text: #5C4033;
                        --color-white: #FFFFFF;
                        --color-success: #2E8B57;
                        --color-error: #CD5C5C;
                        --color-warning: #DAA520;
                        --color-star: #FFD700;
                    }

