                    font-weight: 600;
                    color: var(--color-primary);
                }

                .bank-rating {
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                    margin-top: 0.5rem;
                }

                .bank-stars {
                    color: var(--color-star);
                }

                .bank-stats {
                    text-align: right;
                }

                .reviews-count {
                    font-weight: 500;
                    margin-bottom: 0.5rem;
                }

                .reviews-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
                    gap: 1.5rem;
                }

                .review-card {
                    background-color: var(--color-white);
                    border-radius: 15px;
                    padding: 1.5rem;
                    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
                    transition: transform 0.3s;
                }

                .review-card:hover {
                    transform: translateY(-5px);
                }

                .review-date {
                    font-size: 0.9rem;
                    color: var(--color-text);
                    opacity: 0.7;
                    margin-bottom: 1rem;
                }

                .review-rating {
                    margin: 1rem 0;
                    color: var(--color-star);
                }

                .review-comment {
                    color: var(--color-text);
                    margin: 1rem 0;
                    line-height: 1.6;
                }

                .review-categories {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 0.5rem;
                    margin-top: 1rem;
                }

                .category-tag {
                    background-color: var(--color-background);
                    padding: 0.3rem 0.8rem;
                    border-radius: 15px;
                    font-size: 0.9rem;
                }

                .no-reviews {
                    text-align: center;
                    padding: 2rem;
                    background-color: var(--color-white);
                    border-radius: 15px;
                    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
                }

                .button {
                    display: inline-block;
                    padding: 0.8rem 1.5rem;
                    background-color: var(--color-primary);
                    color: var(--color-white);
                    text-decoration: none;
                    border-radius: 8px;
                    transition: background-color 0.3s;
                    text-align: center;
                }

                .button:hover {
                    background-color: var(--color-secondary);
                }

                .back-link {
                    display: inline-flex;
                    align-items: center;
                    gap: 0.5rem;
                    color: var(--color-primary);
                    text-decoration: none;
                    margin-bottom: 1.5rem;
                    font-weight: 500;
                }

                .back-link:hover {
                    text-decoration: underline;
                }

                .view-all {
                    display: block;
                    margin-top: 1rem;
                    text-align: center;
                }

                @media (max-width: 768px) {
                    .navbar-content {
                        flex-direction: row;
                        justify-content: space-between;
                        align-items: center;
                        position: relative;
                    }

                    .hamburger-menu {
                        display: flex;
                    }

                    .nav-links {
                        position: fixed;
                        top: 0;
                        right: -100%;
                        flex-direction: column;
                        background-color: var(--color-white);
                        width: 80%;
                        max-width: 300px;
                        height: 100vh;
                        z-index: 99;
                        padding: 80px 20px 20px;
                        box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
                        transition: right 0.3s ease-in-out;
                        align-items: flex-start;
                    }

                    .nav-links.mobile-active {
                        right: 0;
                    }

                    .main-content {
                        margin-top: 80px;
                        padding: 1rem;
                    }

                    .bank-header {
                        flex-direction: column;
                        text-align: center;
                    }

                    .bank-stats {
                        text-align: center;
                    }
                }
            </style>
        </head>
        <body>
            ${renderNavbar()}

            <main class="main-content">
                <a href="/estados" class="back-link">
                    <i class="fas fa-arrow-left"></i> Volver a Estados
                </a>
                
                <div class="reviews-header">
                    <h1>Reseñas de Usuarios</h1>
                    <p>Experiencias compartidas por nuestros usuarios</p>
                    ${totalReseñas > 0 ? `<p>Total de reseñas: ${totalReseñas}</p>` : ''}
                </div>

                ${totalReseñas === 0 ? `
                    <div class="no-reviews">
                        <p>Aún no hay reseñas disponibles</p>
                        <a href="/estados" class="button" style="margin-top: 1rem;">Evaluar un Banco</a>
                    </div>
                ` : ''}

                ${bancos.map(banco => {
                    const bancoDatos = reseñasPorBanco[banco.nombre];
                    if (bancoDatos.cantidad === 0) return '';
                    
                    return `
                    <div class="bank-section">
                        <div class="bank-header">
                            <img src="${obtenerImagenBanco(banco.nombre)}" alt="${banco.nombre} Logo" class="bank-logo">
                            
                            <div class="bank-info">
                                <div class="bank-name">${banco.nombre}</div>
                                <div class="bank-rating">
                                    ${bancoDatos.promedio} 
                                    <div class="bank-stars">
                                        ${renderStars(parseFloat(bancoDatos.promedio))}
                                    </div>
                                </div>
                            </div>
                            
                            <div class="bank-stats">
                                <div class="reviews-count">${bancoDatos.cantidad} reseña${bancoDatos.cantidad !== 1 ? 's' : ''}</div>
                                <a href="/evaluar/${banco.nombre}" class="button">Evaluar</a>
                                <a href="/reseñas/${banco.nombre}" class="button" style="margin-left: 0.5rem;">Ver Todas</a>
                            </div>
                        </div>

                        <div class="reviews-grid">
                            ${bancoDatos.reseñas.slice(0, 3).map(reseña => `
                                <div class="review-card">
                                    <div class="review-date">${reseña.fecha}</div>
                                    <div class="review-rating">
                                        ${renderStars(parseInt(reseña.calificación))}
                                    </div>
                                    <div class="review-comment">
                                        ${reseña.comentario}
                                    </div>
                                    <div class="review-categories">
                                        ${reseña.categorías.map(cat => `
                                            <span class="category-tag">${cat}</span>
                                        `).join('')}
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                        
                        ${bancoDatos.reseñas.length > 3 ? `
                            <div class="view-all">
                                <a href="/reseñas/${banco.nombre}" class="button">Ver todas las reseñas de ${banco.nombre}</a>
                            </div>
                        ` : ''}
                    </div>
                    `;
                }).join('')}
            </main>
        </body>
    </html>
    `;
    ctx.response.body = htmlContent;
});

