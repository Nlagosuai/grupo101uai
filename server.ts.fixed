                }

                .report-header {
                    text-align: center;
                    margin-bottom: 2rem;
                }

                .report-header h1 {
                    color: var(--color-primary);
                    font-size: 2rem;
                    margin-bottom: 1rem;
                }

                .report-form {
                    display: flex;
                    flex-direction: column;
                    gap: 1.5rem;
                }

                .form-group {
                    display: flex;
                    flex-direction: column;
                    gap: 0.5rem;
                }

                .form-group label {
                    font-weight: 500;
                    color: var(--color-text);
                }

                .form-control {
                    padding: 0.8rem;
                    border: 2px solid var(--color-secondary);
                    border-radius: 8px;
                    font-family: inherit;
                    font-size: 1rem;
                    transition: border-color 0.3s;
                }

                .form-control:focus {
                    outline: none;
                    border-color: var(--color-primary);
                }

                select.form-control {
                    cursor: pointer;
                }

                textarea.form-control {
                    resize: vertical;
                    min-height: 120px;
