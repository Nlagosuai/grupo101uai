                    <div class="bank-header">
                        <img src="${imagenBanco}" 
                             alt="${banco} Logo" 
                             class="bank-logo">
                        <div class="bank-info">
                            <h1>Evaluar ${banco}</h1>
                            <p>Comparte tu experiencia con el servicio</p>
                        </div>
                    </div>

                    <form class="evaluation-form" id="evaluationForm" method="POST">
                        <div class="form-group">
                            <label>¿Cómo calificarías tu experiencia?</label>
                            <div class="star-rating">
                                <div class="stars">
                                    <input type="radio" name="calificación" value="1" id="rating1" required hidden>
                                    <label for="rating1" class="star" data-rating="1">
                                        <i class="fas fa-star"></i>
                                    </label>
                                    
                                    <input type="radio" name="calificación" value="2" id="rating2" hidden>
                                    <label for="rating2" class="star" data-rating="2">
                                        <i class="fas fa-star"></i>
                                    </label>
                                    
                                    <input type="radio" name="calificación" value="3" id="rating3" hidden>
                                    <label for="rating3" class="star" data-rating="3">
                                        <i class="fas fa-star"></i>
                                    </label>
                                    
                                    <input type="radio" name="calificación" value="4" id="rating4" hidden>
                                    <label for="rating4" class="star" data-rating="4">
                                        <i class="fas fa-star"></i>
                                    </label>
                                    
                                    <input type="radio" name="calificación" value="5" id="rating5" hidden>
                                    <label for="rating5" class="star" data-rating="5">
                                        <i class="fas fa-star"></i>
                                    </label>
                                </div>
                                <div class="rating-text">Selecciona una calificación</div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Categorías</label>
                            <div class="category-tags">
                                <input type="checkbox" name="categorías" value="acceso" id="catAcceso" hidden>
                                <label for="catAcceso" class="category-tag">Problemas de Acceso</label>
                                
                                <input type="checkbox" name="categorías" value="lentitud" id="catLentitud" hidden>
                                <label for="catLentitud" class="category-tag">Lentitud</label>
                                
                                <input type="checkbox" name="categorías" value="error" id="catError" hidden>
                                <label for="catError" class="category-tag">Error en Transacción</label>
                                
                                <input type="checkbox" name="categorías" value="seguridad" id="catSeguridad" hidden>
                                <label for="catSeguridad" class="category-tag">Seguridad</label>
                                
                                <input type="checkbox" name="categorías" value="otro" id="catOtro" hidden>
                                <label for="catOtro" class="category-tag">Otro</label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Describe tu experiencia</label>
                            <textarea 
                                name="comentario"
                                placeholder="Cuéntanos más sobre tu experiencia con el servicio..."
                                required
                            ></textarea>
                        </div>

                        <div class="buttons-container">
                            <button type="submit" class="button">Enviar Evaluación</button>
                            <a href="/estados" class="button button-secondary">Volver a Estados</a>
                        </div>
                    </form>

                    <script>
                        // Manejar selección de estrellas
                        const stars = document.querySelectorAll('.star');
                        const ratingText = document.querySelector('.rating-text');
                        const ratingTexts = {
                            1: 'Malo',
                            2: 'Regular',
                            3: 'Bueno',
                            4: 'Muy Bueno',
                            5: 'Excelente'
                        };
                        
                        stars.forEach(star => {
                            star.addEventListener('click', () => {
                                const rating = star.dataset.rating;
                                const input = document.querySelector("#rating" + rating);
                                input.checked = true;
                                
                                // Actualizar el estilo de las estrellas
                                stars.forEach((s, index) => {
                                    if (index < rating) {
                                        s.classList.add('active');
                                    } else {
                                        s.classList.remove('active');
                                    }
                                });
                                
                                // Actualizar el texto
                                ratingText.textContent = ratingTexts[rating];
                            });
                            
                            // Evento hover para previsualizar
                            star.addEventListener('mouseenter', () => {
                                const rating = star.dataset.rating;
                                
                                stars.forEach((s, index) => {
                                    if (index < rating) {
                                        s.classList.add('active');
                                    } else {
                                        s.classList.remove('active');
                                    }
                                });
                                
                                ratingText.textContent = ratingTexts[rating];
                            });
                        });
                        
                        // Restablecer estrellas al salir sin seleccionar
                        const starContainer = document.querySelector('.stars');
                        starContainer.addEventListener('mouseleave', () => {
                            const selectedRating = document.querySelector('input[name="calificación"]:checked');
                            
                            if (selectedRating) {
                                const rating = selectedRating.value;
                                
                                stars.forEach((s, index) => {
                                    if (index < rating) {
                                        s.classList.add('active');
                                    } else {
                                        s.classList.remove('active');
                                    }
                                });
                                
                                ratingText.textContent = ratingTexts[rating];
                            } else {
                                stars.forEach(s => s.classList.remove('active'));
                                ratingText.textContent = 'Selecciona una calificación';
                            }
                        });

                        // Manejar selección de categorías
                        const categoryTags = document.querySelectorAll('.category-tag');
                        categoryTags.forEach(tag => {
                            tag.addEventListener('click', () => {
                                const input = document.querySelector("#" + tag.getAttribute('for'));
                                input.checked = !input.checked;
                                tag.classList.toggle('active', input.checked);
                            });
                        });

                        // Manejar envío del formulario - versión simplificada
                        document.getElementById('evaluationForm').addEventListener('submit', function(e) {
                            // Verificar que al menos una categoría esté seleccionada
                            const categorias = document.querySelectorAll('input[name="categorías"]:checked');
                            if (categorias.length === 0) {
                                // Seleccionar automáticamente "Otro" si no hay categorías seleccionadas
                                const otroInput = document.querySelector('#catOtro');
                                otroInput.checked = true;
                                document.querySelector('label[for="catOtro"]').classList.add('active');
                            }
                            // Dejar que el formulario se envíe normalmente
                        });
                    </script>
                </div>
            </main>
        </body>
    </html>
    `;
    ctx.response.body = htmlContent;
});

// Ruta para reportar errores
router.get("/reportar", async (ctx) => {
    let htmlContent = `
    <html>
