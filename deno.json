{
  "compilerOptions": {
    "lib": ["deno.window"]
  },
  "importMap": "import_map.json",
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-env server.ts"
  },
  "lint": {
    "files": {
      "include": [
        "**/*.ts",
        "**/*.tsx"
      ],
      "exclude": [
        "**/*_test.ts"
      ]
    },
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-unused-vars"
      ]
    }
  },
  "fmt": {
    "options": {
      "useTabs": true,
      "lineWidth": 80,
      "indentWidth": 4,
      "singleQuote": false
    }
  }
}